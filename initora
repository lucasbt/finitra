#!/usr/bin/env bash
# =============================================================================
# initora -- Fedora Workstation Bootstrap for Developers
#
# Usage:
#   initora                      Interactive menu
#   initora install              Run all modules in sequence
#   initora install --all        Run all modules (explicit)
#   initora -ia                  Run all modules (short form)
#   initora install -m <id>      Run a specific module (by number or name)
#   initora list                 List available modules
#   initora update               Self-update from the remote repository
#   initora uninstall            Uninstall initora
#   initora config               Open user config in $EDITOR
#   initora --help               Show this help
#
# Install dir:  ~/.local/share/initora
# User config:  ~/.config/initora/initora.config
# Log:          ~/.cache/initora/initora.log
# =============================================================================

# =============================================================================
# Global error handler
# =============================================================================

set -Eeuo pipefail

CURRENT_MODULE="initora-main"

initialize_sudo() {
  echo ""
  log_warn "Requesting administrator privileges..."

  sudo -n true && log_success "Sudo Session Active!" || true

  sudo -v || {
    log_error "Failed to acquire sudo privileges"
    exit 1
  }

  # Keep sudo session alive
  while true; do
    sudo -n true
    sleep 60
    kill -0 "$$" || exit
  done 2>/dev/null &

  SUDO_KEEPALIVE_PID=$!
}

cleanup() {
  local exit_code=$?

  if [[ $exit_code -eq 0 ]]; then
    sudo find ~/.cache/initora/ -mindepth 1 ! -name '*.log' -delete
    sudo dnf autoremove -yq > /dev/null
  fi

  kill "$SUDO_KEEPALIVE_PID" &>/dev/null || true
}

_error_handler() {
  local exit_code=$?
  local line_no="$1"
  local command="${2:-unknown}"

  {
    echo ""
    echo "════════════════════════════════════════════════════════════"
    echo " INITORA ERROR"
    echo "════════════════════════════════════════════════════════════"
    echo ""
    echo "Module      : ${CURRENT_MODULE}"
    echo "Exit code   : ${exit_code}"
    echo "Line        : ${line_no}"
    echo "Command     : ${command}"

    if [[ -n "${BASH_SOURCE[1]:-}" ]]; then
      echo "File        : ${BASH_SOURCE[1]}"
    fi

    echo ""
    echo "Stack trace:"

    local i
    for ((i=${#FUNCNAME[@]}-1; i>=1; i--)); do
      echo "  -> ${FUNCNAME[$i]} (${BASH_SOURCE[$i]}:${BASH_LINENO[$((i-1))]})"
    done

    echo ""
    echo "Check log: ${LOG_FILE:-unknown}"
    echo "════════════════════════════════════════════════════════════"
    echo ""
  } | tee -a "${LOG_FILE:-/tmp/initora.log}" >&2

  exit "$exit_code"
}

trap '_error_handler ${LINENO} "$BASH_COMMAND"' ERR

# =============================================================================
# Detect the real (non-root) user before loading config
# Supports: plain run, sudo, and sudo with env passthrough
# =============================================================================
_detect_user() {
  if [[ -n "${SETUP_USER:-}" && "${SETUP_USER}" != "root" ]]; then
    SETUP_HOME="${SETUP_HOME:-$(eval echo "~${SETUP_USER}")}"
    return
  fi

  if [[ $EUID -eq 0 && -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
    SETUP_USER="$SUDO_USER"
    SETUP_HOME=$(eval echo "~${SUDO_USER}")
    return
  fi

  if [[ $EUID -ne 0 ]]; then
    SETUP_USER="$USER"
    SETUP_HOME="$HOME"
    return
  fi

  local logname_user
  logname_user=$(logname 2>/dev/null || true)
  if [[ -n "$logname_user" && "$logname_user" != "root" ]]; then
    SETUP_USER="$logname_user"
    SETUP_HOME=$(eval echo "~${logname_user}")
    return
  fi

  echo "ERROR: Could not determine the real user. Run as your regular user or via sudo." >&2
  exit 1
}

_detect_user

export HOME="$SETUP_HOME"
BIN_DIR="${SETUP_HOME}/.local/bin"
BIN_PATH="${BIN_DIR}/initora"
CONFIG_DIR="${SETUP_HOME}/.config/initora"
CONFIG_FILE="${CONFIG_DIR}/initora.config"
SCRIPT_DIR="${SETUP_HOME}/.local/share/initora"
SCRIPT_VERSION="$(cat "${SCRIPT_DIR}/version" 2>/dev/null | tr -d '[:space:]' || echo "unknown")"

# =============================================================================
# Load config (default + user override)
# =============================================================================
source "${SCRIPT_DIR}/utils.sh"
source "${SCRIPT_DIR}/initora-default.config"

USER_CONFIG="${SETUP_HOME}/.config/initora/initora.config"
if [[ $EUID -eq 0 && -n "${SETUP_HOME:-}" ]]; then
  USER_CONFIG="${SETUP_HOME}/.config/initora/initora.config"
fi

if [[ ! -f "$USER_CONFIG" ]]; then
  mkdir -p "$(dirname "$USER_CONFIG")"
  install -m 600 "${SCRIPT_DIR}/initora-default.config" "$USER_CONFIG"
  log_info "User config created at: $USER_CONFIG"
fi

# shellcheck disable=SC1090
source "$USER_CONFIG"

[[ -z "${SETUP_USER:-}" ]] && SETUP_USER="$USER"
[[ -z "${SETUP_HOME:-}" ]] && SETUP_HOME=$(eval echo "~${SETUP_USER}")

LOG_FILE="${CACHE_DIR:-${SETUP_HOME}/.cache/initora}/initora.log"
mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
: > "$LOG_FILE"

export SETUP_USER SETUP_HOME LOG_FILE

_safe_clear() {
  [[ "${INITORA_ALL_RUN:-0}" == "1" ]] && return 0
  clear
}

# =============================================================================
# Module discovery
# =============================================================================

declare -A MODULE_FILES
declare -A MODULE_NAMES

_discover_modules() {
  local modules_dir="${SCRIPT_DIR}/modules"
  while IFS= read -r -d '' file; do
    local base
    base=$(basename "$file" .sh)
    local num="${base%%-*}"
    local name="${base#*-}"
    MODULE_FILES["$num"]="$file"
    MODULE_NAMES["$num"]="${num} -- ${name}"
  done < <(find "$modules_dir" -maxdepth 1 -name "[0-9]*.sh" -print0 | sort -z)
}

_resolve_module_id() {
  local input="$1"

  if [[ -n "${MODULE_FILES[$input]:-}" ]]; then
    echo "$input"
    return 0
  fi

  local key
  for key in "${!MODULE_FILES[@]}"; do
    local base
    base=$(basename "${MODULE_FILES[$key]}" .sh)
    local name_part="${base#*-}"
    if [[ "$name_part" == "$input" || "$base" == "$input" ]]; then
      echo "$key"
      return 0
    fi
  done

  return 1
}

# =============================================================================
# Module execution
# =============================================================================

_run_module() {
  local input="$1"
  local resolved

  if ! resolved=$(_resolve_module_id "$input"); then
    log_error "Module not found: '$input'"
    return 1
  fi

  initialize_sudo

  local file="${MODULE_FILES[$resolved]}"

  CURRENT_MODULE="$(basename "$file")"

  log_info "Loading module: ${CURRENT_MODULE}"

  # shellcheck disable=SC1090
  source "$file"

  local funcname
  funcname="module_$(basename "$file" .sh | tr '-' '_')"

  if ! declare -f "$funcname" >/dev/null; then
    log_error "Function '$funcname' not found in $file"
    return 1
  fi

  "$funcname"

  CURRENT_MODULE="initora-main"
}

_run_all_modules() {
  export INITORA_ALL_RUN=1
  local sorted_keys
  mapfile -t sorted_keys < <(printf '%s\n' "${!MODULE_FILES[@]}" | sort)

  initialize_sudo

  log_section "Running ALL modules in sequence"
  
  for num in "${sorted_keys[@]}"; do
    _run_module "$num"
  done
  unset INITORA_ALL_RUN
  log_success "All modules completed successfully!"
}

# =============================================================================
# Migrations
#
# Migration files live under ${SCRIPT_DIR}/migrations and follow the same
# naming convention as modules: NNNN-description.sh -> function
# migration_NNNN_description().
#
# Applied migrations are recorded (one id per line) in a state file kept
# OUTSIDE the git working tree (${CONFIG_DIR}), since `initora update` may
# run `git reset --hard` + `git clean -fd` on the install dir, which would
# wipe out any state file stored inside it. It also can't live under
# ~/.cache/initora, since cleanup() purges that directory (except *.log)
# after every successful run.
# =============================================================================

MIGRATIONS_DIR="${SCRIPT_DIR}/migrations"
MIGRATIONS_STATE_FILE="${CONFIG_DIR}/migrations_applied"

_run_pending_migrations() {
  [[ -d "$MIGRATIONS_DIR" ]] || return 0

  mkdir -p "$CONFIG_DIR"
  touch "$MIGRATIONS_STATE_FILE"

  find "$MIGRATIONS_DIR" -maxdepth 1 -name "*.sh" -exec chmod +x {} \; 2>/dev/null || true

  local pending=()
  local file id
  while IFS= read -r -d '' file; do
    id="$(basename "$file" .sh)"
    grep -qxF "$id" "$MIGRATIONS_STATE_FILE" || pending+=("$file")
  done < <(find "$MIGRATIONS_DIR" -maxdepth 1 -name "*.sh" -print0 | sort -z)

  if [[ ${#pending[@]} -eq 0 ]]; then
    log_info "No pending migrations."
    return 0
  fi

  log_section "Applying ${#pending[@]} pending migration(s)"

  local funcname
  for file in "${pending[@]}"; do
    id="$(basename "$file" .sh)"
    funcname="migration_$(echo "$id" | tr '-' '_')"

    log_info "Applying migration: ${id}"

    # shellcheck disable=SC1090
    source "$file"

    if ! declare -f "$funcname" >/dev/null; then
      log_error "Function '${funcname}' not found in ${file}"
      log_error "Migration file must define: ${funcname}() { ... }"
      log_error "Aborting. Fix the migration and re-run 'initora update'."
      return 1
    fi

    if "$funcname"; then
      echo "$id" >> "$MIGRATIONS_STATE_FILE"
      log_success "Migration applied: ${id}"
    else
      log_error "Migration failed: ${id}"
      log_error "Aborting remaining migrations. Fix the issue and re-run 'initora update'."
      unset -f "$funcname"
      return 1
    fi

    unset -f "$funcname"
  done

  log_success "All pending migrations applied."
}

# =============================================================================
# Self-update
# =============================================================================

_cmd_update() {
  log_section "initora self-update"

  local install_dir="${SETUP_HOME}/.local/share/initora"

  if [[ ! -d "${install_dir}/.git" ]]; then
    log_error "Install directory is not a git repository: $install_dir"
    log_error "Cannot self-update. Please re-run bootstrap.sh."
    exit 1
  fi

  local current_rev
  current_rev="$(git -C "$install_dir" rev-parse HEAD 2>/dev/null)"

  # Ignore file-mode-only diffs (chmod +x applied to modules/migrations on
  # every run) so they're never mistaken for local changes on a re-run.
  git -C "$install_dir" config core.fileMode false

  local has_changes=false

  if ! git -C "$install_dir" diff --quiet 2>/dev/null || \
     ! git -C "$install_dir" diff --cached --quiet 2>/dev/null; then
    has_changes=true
  fi

  # ---------------------------------------------------------------------------
  # Handle local changes
  # ---------------------------------------------------------------------------

  if [[ "$has_changes" == "true" ]]; then
    echo ""

    log_warn "Local uncommitted changes detected in $install_dir:"

    git -C "$install_dir" status --short

    echo ""

    if has_cmd gum; then
      if ! gum confirm "Discard local changes and update from remote?"; then
        log_warn "Update aborted. Local changes preserved."
        exit 0
      fi
    else
      echo "  [O] Overwrite -- discard local changes and update from remote"
      echo "  [A] Abort    -- keep local changes and cancel the update"
      echo ""

      read -rp "Choice [O/A]: " answer
      answer="${answer:-A}"

      if [[ "${answer^^}" != "O" ]]; then
        log_warn "Update aborted. Local changes preserved."
        exit 0
      fi
    fi

    log_info "Discarding local changes and updating..."

    git -C "$install_dir" fetch --quiet origin
    git -C "$install_dir" reset --hard origin/main
    git -C "$install_dir" clean -fd

  else
    log_info "Pulling latest changes from remote..."

    git -C "$install_dir" pull --ff-only --quiet
  fi

  # ---------------------------------------------------------------------------
  # Restore permissions
  # ---------------------------------------------------------------------------

  chmod +x "${install_dir}/initora"

  find "${install_dir}/modules" \
    -name "*.sh" \
    -exec chmod +x {} \;

  find "${install_dir}/migrations" \
    -name "*.sh" \
    -exec chmod +x {} \; 2>/dev/null || true

  # ---------------------------------------------------------------------------
  # Version / revision info
  # ---------------------------------------------------------------------------

  local new_rev
  new_rev="$(git -C "$install_dir" rev-parse HEAD 2>/dev/null)"

  local new_version
  new_version="$(
    cat "${install_dir}/version" 2>/dev/null \
      | tr -d '[:space:]'
  )"

  # ---------------------------------------------------------------------------
  # Pending migrations
  # Runs regardless of whether the repo itself changed: a migration can be
  # left pending from a previous update (e.g. it failed, or the state file
  # was reset), so it must be checked every time, not just on new commits.
  # ---------------------------------------------------------------------------

  _run_pending_migrations || {
    log_error "Update finished with pending/failed migrations. See log for details."
    exit 1
  }

  # ---------------------------------------------------------------------------
  # Already updated
  # ---------------------------------------------------------------------------

  if [[ "$current_rev" == "$new_rev" ]]; then
    log_success "initora is already up to date (${new_version})"
    return 0
  fi

  # ---------------------------------------------------------------------------
  # Success output
  # ---------------------------------------------------------------------------

  echo ""

  log_success "initora updated to version ${new_version}"

  echo ""
  echo -e "${CLR_BOLD}Latest changes:${CLR_RESET}"

  git -C "$install_dir" \
    log \
      --pretty=format:"  • %C(yellow)%h%Creset %s%n    %C(cyan)%an%Creset %C(dim white)(%cr)%Creset" \
      "${current_rev}..${new_rev}"

  echo ""
  echo ""

  log_info "User config preserved at: ${SETUP_HOME}/.config/initora/initora.config"
}

# =============================================================================
# Open user config in $EDITOR
# =============================================================================

_cmd_config() {
  local config_file="${SETUP_HOME}/.config/initora/initora.config"

  if [[ ! -f "$config_file" ]]; then
    log_info "User config not found. Creating from defaults..."
    mkdir -p "$(dirname "$config_file")"
    cp "${SCRIPT_DIR}/initora-default.config" "$config_file"
    log_success "Config created: $config_file"
  fi

  local editor="${EDITOR:-${VISUAL:-vi}}"
  log_info "Opening config with: $editor"
  "$editor" "$config_file"
}

# =============================================================================
# Interactive menu -- gum (primary), select built-in (fallback)
# =============================================================================

_menu_gum() {
  local sorted_keys
  mapfile -t sorted_keys < <(printf '%s\n' "${!MODULE_FILES[@]}" | sort)

  # Build display labels (format matches MODULE_NAMES: "NN -- name")
  local labels=()
  labels+=("all  --  Run ALL modules")
  for num in "${sorted_keys[@]}"; do
    labels+=("${MODULE_NAMES[$num]}")
  done

  local chosen
  chosen=$(
    printf '%s\n' "${labels[@]}" \
    | gum choose \
        --no-limit \
        --header "  initora v${SCRIPT_VERSION} — select modules to run" \
        --header.foreground="12" \
        --selected.foreground="10" \
        --cursor.foreground="14"
  ) || { echo "Cancelled."; exit 0; }

  [[ -z "$chosen" ]] && { echo "No modules selected. Exiting."; exit 0; }

  # If "all" appears anywhere in the selection, run everything
  if echo "$chosen" | grep -q "^all"; then
    _run_all_modules
    return
  fi

  # Parse numeric keys from labels ("NN -- name" -> "NN")
  local sorted_chosen
  mapfile -t sorted_chosen < <(echo "$chosen" | sort)
  for line in "${sorted_chosen[@]}"; do
    [[ -z "$line" ]] && continue
    local num
    num="${line%% --*}"
    num="${num// /}"  # trim whitespace
    _run_module "$num"
  done
}


_menu_select() {
  echo ""
  echo "  initora v${SCRIPT_VERSION}"
  echo "  Fedora Workstation Bootstrap for Developers"
  echo ""

  local sorted_keys
  mapfile -t sorted_keys < <(printf '%s\n' "${!MODULE_FILES[@]}" | sort)

  local menu_items=("all: Run ALL modules")
  for num in "${sorted_keys[@]}"; do
    menu_items+=("${MODULE_NAMES[$num]}")
  done
  menu_items+=("exit: Exit without changes")

  PS3=$'\nChoose an option: '
  select choice in "${menu_items[@]}"; do
    case "$choice" in
      "all: Run ALL modules")
        _run_all_modules
        break ;;
      "exit: Exit without changes")
        echo "Exiting."
        exit 0 ;;
      *)
        if [[ -n "$choice" ]]; then
          local num="${choice%% --*}"
          _run_module "$num"
          break
        else
          echo "Invalid option. Please try again."
        fi ;;
    esac
  done
}

_show_menu() {
  if has_cmd gum; then
    _menu_gum
  else
    _menu_select
  fi
}

# =============================================================================
# Pre-run checks
# =============================================================================

_preflight_check() {
  if [[ ! -f /etc/fedora-release ]]; then
    log_warn "Operating system is not Fedora. Proceeding anyway..."
  else
    local fedora_ver
    fedora_ver=$(rpm -E %fedora)
    log_info "Detected Fedora version: $fedora_ver"
    if [[ "$fedora_ver" -lt 40 ]]; then
      log_warn "This script targets Fedora 40+. Detected version: $fedora_ver"
    fi
  fi

  log_info "Target user : ${SETUP_USER} (home: ${SETUP_HOME})"
  log_info "Log file    : ${LOG_FILE}"
}

