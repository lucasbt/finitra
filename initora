# =============================================================================
# Uninstall initora
# =============================================================================

_cmd_uninstall() {
  log_section "Uninstalling initora"

  log_warn "This will remove the initora binary, configuration, cache, and shell aliases."

  if ! ask_yes_no "Are you sure you want to proceed with uninstallation?" "n"; then
    log_info "Uninstallation aborted."
    exit 0
  fi

  # ---------------------------------------------------------------------------
  # Remove binary
  # ---------------------------------------------------------------------------

  log_info "Removing binary..."

  if [[ -L "$BIN_PATH" || -f "$BIN_PATH" ]]; then
    rm -f "$BIN_PATH"
    ok "Binary removed: $BIN_PATH"
  else
    log_info "Binary already removed."
  fi

  # ---------------------------------------------------------------------------
  # Remove configuration
  # ---------------------------------------------------------------------------

  log_info "Removing configuration..."

  if [[ -d "$CONFIG_DIR" ]]; then
    rm -rf "$CONFIG_DIR"
    ok "Configuration removed: $CONFIG_DIR"
  else
    log_info "Configuration already removed."
  fi

  # ---------------------------------------------------------------------------
  # Remove cache/logs
  # IMPORTANT:
  # After this point DO NOT use file logger anymore.
  # ---------------------------------------------------------------------------

  local cache_dir="${SETUP_HOME}/.cache/initora"

  log_info "Removing cache and logs..."

  if [[ -d "$cache_dir" ]]; then
    rm -rf "$cache_dir"
  fi

  # From here forward:
  # - avoid log_info / ok / log_warn
  # - use echo only

  echo -e "${CLR_BOLD}${CLR_GREEN}✔ Cache removed: $cache_dir${CLR_RESET}"

  # ---------------------------------------------------------------------------
  # Remove installation directory
  # ---------------------------------------------------------------------------

  if [[ -d "$SCRIPT_DIR" ]]; then
    rm -rf "$SCRIPT_DIR"

    echo -e "${CLR_BOLD}${CLR_GREEN}✔ Installation directory removed:${CLR_RESET} $SCRIPT_DIR"
  fi

  # ---------------------------------------------------------------------------
  # Final message
  # ---------------------------------------------------------------------------

  echo ""
  echo -e "${CLR_BOLD}${CLR_GREEN}initora has been successfully uninstalled.${CLR_RESET}"
  echo -e "Please restart your terminal or run 'source ~/.bashrc' to apply changes."
  echo ""

  # IMPORTANT:
  # Exit immediately because runtime files were deleted.
  exit 0
}

# =============================================================================
# Help
# =============================================================================

_show_help() {
  cat << HELPEOF
initora v${SCRIPT_VERSION} -- Fedora Workstation Bootstrap for Developers

Usage:
  initora                      Interactive menu
  fi                           Short alias

  initora install              Run all modules in sequence
  initora install --all        Run all modules (explicit)
  initora -ia                  Run all modules (short form)

  initora install -m <id>      Run a specific module (by number or name)
  initora install --module <id>
  initora -i -m <id>

  initora list                 List available modules
  initora update               Self-update from remote repository
  initora uninstall            Completely remove initora from the system
  initora config               Open user config in \$EDITOR
  initora log                  View execution logs (interactive)
  initora --help               Show this help

Module identifier accepts:
  Number      initora install -m 30
  Name        initora install -m desktop
  Full name   initora install -m 30-desktop

Examples:
  initora
  initora install
  initora -ia
  initora install -m 30
  initora install --module desktop
  initora -i -m dev-tools
  initora list
  initora update
  initora config
  initora log
HELPEOF
}

# =============================================================================
# Entry point
# =============================================================================

main() {
  case "${1:-}" in
    update)
      _detect_user
      _cmd_update
      exit 0
      ;;
    uninstall)
      _detect_user
      _cmd_uninstall
      exit 0
      ;;
    config)
      _cmd_config
      exit 0
      ;;
    log)
      if [[ -f "${LOG_FILE}" ]]; then
        less +G "${LOG_FILE}"
      else
        echo "Log file not found: ${LOG_FILE}"
        exit 1
      fi
      exit 0
      ;;
    help|--help|-h)      _show_help
      exit 0
      ;;
    list|--list)
      _discover_modules
      echo "Available modules:"
      local sorted_keys
      mapfile -t sorted_keys < <(printf '%s\n' "${!MODULE_FILES[@]}" | sort)
      for num in "${sorted_keys[@]}"; do
        local base
        base=$(basename "${MODULE_FILES[$num]}" .sh)
        printf "  %-6s  %-22s  %s\n" "$num" "$base" "${MODULE_FILES[$num]}"
      done
      exit 0
      ;;
  esac

  if [[ -z "${INITORA_CHILD:-}" ]]; then
    _print_banner
    _preflight_check
  fi

  _discover_modules

  local cmd="${1:-}"
  local action=""
  local module_id=""

  case "$cmd" in
    install|-i)
      shift
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --all|-a)
            action="all"
            shift
            ;;
          --module|-m)
            action="module"
            module_id="${2:-}"
            if [[ -z "$module_id" ]]; then
              log_error "Specify a module: install -m <number|name>"
              _show_help
              exit 1
            fi
            shift 2
            ;;
          *)
            log_error "Unknown install option: $1"
            _show_help
            exit 1
            ;;
        esac
      done

      [[ -z "$action" ]] && action="all"

      case "$action" in
        all)    _run_all_modules ;;
        module) _run_module "$module_id" ;;
      esac
      ;;

    --all)
      _run_all_modules
      return 0
      ;;
    --module)
      local input="${2:-}"
      if [[ -z "$input" ]]; then
        log_error "Specify a module: --module <number|name>"
        _show_help
        exit 1
      fi
      _run_module "$input"
      ;;

    "")
      _show_menu
      ;;

    *)
      log_error "Unknown command: $cmd"
      log_info "Use 'initora --help' for usage information"
      _show_help
      exit 1
      ;;
  esac

  echo ""
  if [[ "${INITORA_CHILD:-}" != "1" ]]; then    
    log_info "Update directory permissions before exiting..."
    run_as_root chown -R $SETUP_USER:$SETUP_USER $SETUP_HOME
    log_info "Running cleanup tasks..."
    cleanup
    echo ""
    log_success "initora done. Log saved to: ${LOG_FILE}"
    echo ""
  fi  
}

main "$@"